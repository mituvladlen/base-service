# Copy to .env and adjust. NEVER commit .env.
PORT=3002

# memory = in-memory store (no DB needed), postgres = PostgreSQL (DATABASE_URL)
STORAGE=postgres

# Used by docker-compose.yml to create the database container
POSTGRES_USER=base_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=base_db
POSTGRES_PORT=5434
DATABASE_URL=postgres://base_user:change_me@localhost:5434/base_db

# mock = built-in fakes (Lab 1), http = real services (Lab 2)
PLAYER_CLIENT=mock
WORLD_CLIENT=mock
# RESOURCE_CLIENT=http calls our own Resource Service (recommended when it is running)
RESOURCE_CLIENT=mock
PLAYER_SERVICE_URL=http://localhost:3000
WORLD_SERVICE_URL=http://localhost:3003
RESOURCE_SERVICE_URL=http://localhost:3001
MOCK_PLAYERS=player-1,player-2,player-3,player-4

# Seconds a player must wait between two Kiki interactions
KIKI_COOLDOWN_SECONDS=30
